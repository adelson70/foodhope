// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RoleOperador {
  ADMIN
  OPERADOR
  TOTEM
}

model Operador {
  id        String       @id @default(uuid())
  nome      String
  senha     String
  role      RoleOperador @default(OPERADOR)
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("operador")
}

model Visitor {
  id                 String    @id @default(uuid())
  publicKey          String    @map("public_key") @db.Text
  verified           Boolean   @default(false)
  challenge          String?
  challengeExpiresAt DateTime? @map("challenge_expires_at")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("visitor")
}

model Lead {
  id            String   @id @default(uuid())
  primeiro_nome String
  sobrenome     String?
  contato       String?
  cidade        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([id])
  @@index([primeiro_nome])
  @@index([primeiro_nome, sobrenome])
  @@map("lead")
}

enum TipoConsumo {
  LEVAR
  COMER_AQUI
}

enum StatusPagamento {
  PAGO
  NAO_PAGO
  GRATUITO
}

model Pedido {
  id            String @id @default(uuid())
  numero BigInt @default(autoincrement()) @unique
  nome_completo String

  tipo_consumo     TipoConsumo     @default(COMER_AQUI) @map("tipo_consumo")
  prontoAt         DateTime?       @map("pronto_at")
  status_pagamento StatusPagamento @default(PAGO) @map("status_pagamento")

  itens PedidoItem[]
  checkoutSessao CheckoutSessao?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([numero])
  @@index([nome_completo])
  @@index([prontoAt])
  @@index([status_pagamento])
  @@map("pedido")
}

model Categoria {
  id    String @id @default(uuid())
  nome  String @unique
  ordem Int

  produtos Produto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ordem])
  @@map("categoria")
}

model Produto {
  id        String  @id @default(uuid())
  nome      String @unique
  descricao String?
  preco     Decimal @db.Decimal(10, 2)
  imagemUrl String? @map("imagem_url")
  ativo                     Boolean @default(true)
  imprimirSeparado          Boolean @default(false) @map("imprimir_separado")
  ignorarImpressaoSozinho   Boolean @default(false) @map("ignorar_impressao_sozinho")
  ordem                     Int     @default(0)

  categoria_id String?    @map("categoria_id")
  categoria    Categoria? @relation(fields: [categoria_id], references: [id], onDelete: SetNull)

  adicionais AdicionalProduto[]
  adicionaisGlobais ProdutoAdicionalGlobal[]
  ingredientes IngredienteProduto[]
  itens PedidoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoria_id])
  @@index([ordem])
  @@map("produto")
}

model AdicionalGlobal {
  id    String  @id @default(uuid())
  nome  String
  preco Decimal @db.Decimal(10, 2)
  ativo Boolean @default(true)

  produtos ProdutoAdicionalGlobal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("adicional_global")
}

model ProdutoAdicionalGlobal {
  produto_id          String @map("produto_id")
  adicional_global_id String @map("adicional_global_id")

  produto          Produto          @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  adicionalGlobal  AdicionalGlobal  @relation(fields: [adicional_global_id], references: [id], onDelete: Cascade)

  @@id([produto_id, adicional_global_id])
  @@map("produto_adicional_global")
}

model AdicionalProduto {
  id String @id @default(uuid())
  produto_id String @map("produto_id")
  nome String
  preco Decimal @db.Decimal(10,2)
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@map("adicional_produto")
}

model IngredienteProduto {
  id         String @id @default(uuid())
  produto_id String @map("produto_id")
  nome       String
  ordem      Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  @@index([produto_id])
  @@map("ingrediente_produto")
}

model PedidoItem {
  id String @id @default(uuid())

  pedido_id  String @map("pedido_id")
  produto_id String @map("produto_id")

  quantidade Int @default(1)

  preco_produto Decimal @db.Decimal(10, 2)

  adicional_venda Json?

  retirada_venda Json?

  observacao String? @db.VarChar(140)

  pedido Pedido @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pedido_id])
  @@index([produto_id])
  @@map("pedido_item")
}

model ConfigImpressora {
  id          String   @id @default("default")
  ip          String?
  dispositivo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("config_impressora")
}

model ConfigInfinitePay {
  id        String   @id @default("default")
  handle    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("config_infinitepay")
}

enum VisualizacaoTelaPedidos {
  DIA
  TUDO
}

model ConfigTelaPedidos {
  id            String                   @id @default("default")
  hash          String
  visualizacao  VisualizacaoTelaPedidos  @default(DIA)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("config_tela_pedidos")
}

model ConfigCozinha {
  id        String   @id @default("default")
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("config_cozinha")
}

model CheckoutSessao {
  id               String    @id @default(uuid())
  payload          Json
  amountCentavos   Int       @map("amount_centavos")
  checkoutUrl      String?   @map("checkout_url")
  invoiceSlug      String?   @map("invoice_slug")
  transactionNsu   String?   @unique @map("transaction_nsu")
  receiptUrl       String?   @map("receipt_url")
  captureMethod    String?   @map("capture_method")
  installments     Int?
  pagoAt           DateTime? @map("pago_at")
  pedidoId         String?   @unique @map("pedido_id")
  pedido           Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checkout_sessao")
}

enum InfinitePayWebhookDirecao {
  ENTRADA
  SAIDA
  ERRO
}

model InfinitePayWebhookLog {
  id             String                     @id @default(uuid())
  correlacaoId   String                     @map("correlacao_id")
  direcao        InfinitePayWebhookDirecao
  orderNsu       String?                    @map("order_nsu")
  transactionNsu String?                    @map("transaction_nsu")
  httpStatus     Int?                       @map("http_status")
  corpo          Json
  createdAt      DateTime                   @default(now())

  @@index([correlacaoId])
  @@index([orderNsu])
  @@index([transactionNsu])
  @@index([createdAt])
  @@map("infinitepay_webhook_log")
}