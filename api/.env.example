PORT=5000
APP=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

DATABASE_URL=postgresql://foodhope:foodhope@localhost:5432/foodhope

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

IP_IMPRESSORA=
# Redes onde procurar impressoras (CIDR, separadas por vírgula, no máximo /22). Ex.: 192.168.1.0/24
IMPRESSORA_REDES=
# Token da ponte ESP32 (mesmo valor do PONTE_TOKEN do firmware). Gere com: openssl rand -hex 32
PONTE_IMPRESSORA_TOKEN=

# Conta de serviço do Firebase em base64, para enviar o aviso de pedido pronto.
# Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# (baixa <projeto>-firebase-adminsdk-....json). Gere com: base64 -w0 <arquivo>.json
# Vazio = push desligado.
FIREBASE_SERVICE_ACCOUNT_BASE64=
