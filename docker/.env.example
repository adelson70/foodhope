POSTGRES_USER=foodhope
POSTGRES_PASSWORD=foodhope
POSTGRES_DB=foodhope

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=5000
API_PUBLISH_PORT=5000
APP=http://localhost
# 80 está em uso por outro projeto nesta máquina; o tunnel usa a rede interna.
WEB_PUBLISH_PORT=8088
VITE_API_URL=http://localhost:5000
API_PUBLIC_URL=http://localhost:5000
VITE_SITE_URL=https://foodhope.abjr.dev

DATABASE_URL=postgresql://foodhope:foodhope@postgres:5432/foodhope

JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

IP_IMPRESSORA=
# Redes onde procurar impressoras (CIDR, separadas por vírgula, no máximo /22). Ex.: 192.168.1.0/24
IMPRESSORA_REDES=
# Token da ponte ESP32 (mesmo valor do PONTE_TOKEN do firmware). Gere com: openssl rand -hex 32
PONTE_IMPRESSORA_TOKEN=
DIALOUT_GID=18
LP_GID=7

CLOUDFLARE_TUNNEL_TOKEN_API=
CLOUDFLARE_TUNNEL_TOKEN_WEB=

# --- Só no servidor de produção ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.servidor.yml
# Porta do Postgres publicada para a réplica do notebook (pg_hba restringe ao IP Tailscale dele)
# PG_REPLICACAO_PORTA=5433
# Senha do role "replicador" (openssl rand -hex 24); a mesma vai em docker/replica/.env
# PG_REPLICA_PASSWORD=
